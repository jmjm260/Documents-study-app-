# Variables de entorno. Copia este archivo a .env.local y rellena los valores.
# .env.local nunca se sube a git.

# Clave de OpenAI para el chat de Tocorito (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Modelo (opcional). Por defecto: gpt-4.1-mini
OPENAI_MODEL=

# Quién responde en el chat: openai (por defecto) o claude (Claude Code local, SOLO pruebas)
CHAT_PROVIDER=
# Opcionales para CHAT_PROVIDER=claude
CLAUDE_MODEL=
CLAUDE_CLI_PATH=

# Modelo por nivel de razonamiento (opcionales). Los gpt-5* y o* reciben reasoning_effort.
OPENAI_MODEL_INSTANT=
OPENAI_MODEL_MEDIUM=
OPENAI_MODEL_HIGH=
# Claude local por nivel (opcionales). Por defecto: haiku / sonnet / sonnet
CLAUDE_MODEL_INSTANT=
CLAUDE_MODEL_MEDIUM=
CLAUDE_MODEL_HIGH=

# Cuentas (inicio de sesión + chats en Supabase). Apagado mientras desarrollamos en local.
ACCOUNTS_ENABLED=false
# Supabase (base de datos y cuentas). Ambos son públicos; la seguridad la dan las reglas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
