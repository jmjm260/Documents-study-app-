# Variables de entorno. Copia este archivo a .env.local y rellena los valores.
# .env.local nunca se sube a git.

# Clave de OpenAI para el chat de Tocorito (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Modelo (opcional). Por defecto: gpt-4.1-mini
OPENAI_MODEL=

# Quién responde en el chat: openai (por defecto) o claude (Claude Code local, SOLO pruebas)
CHAT_PROVIDER=
# Opcionales para CHAT_PROVIDER=claude
CLAUDE_MODEL=
CLAUDE_CLI_PATH=
